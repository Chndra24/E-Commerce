/**
 * Salin file ini menjadi `.env` lalu isi nilainya.
 * `.env` tidak pernah ikut di-commit (lihat .gitignore).
 */

# Koneksi database (Supabase pooler).
# DATABASE_URL memakai transaction pooler (port 6543) untuk runtime aplikasi.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL memakai session pooler (port 5432) dan hanya dipakai Prisma Migrate.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Rahasia sesi Auth.js. Hasilkan dengan: npx auth secret
AUTH_SECRET=""

# Diperlukan saat berjalan di belakang proxy (Vercel).
AUTH_TRUST_HOST="true"

# Header secret untuk endpoint /api/cron/rfm.
CRON_SECRET=""

# Asumsi margin untuk estimasi CLV (0.3 = 30%).
CLV_MARGIN="0.3"
